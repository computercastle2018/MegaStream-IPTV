{
  "name": "streamvault-webos",
  "version": "0.1.0",
  "private": true,
  "description": "StreamVault IPTV — standalone webOS TV app (Live TV MVP)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "package": "npm run build && ares-package dist -o out",
    "install-tv": "ares-install -d tv out/com.streamvault.webos_0.1.0_all.ipk",
    "launch-tv": "ares-launch -d tv com.streamvault.webos"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^3.1.0",
    "hls.js": "^1.5.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
