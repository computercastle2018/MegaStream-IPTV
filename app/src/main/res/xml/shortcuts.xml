<?xml version="1.0" encoding="utf-8"?>
<!--
  Static launcher shortcuts shown on long-press of the launcher icon.
  Each targets MainActivity with EXTRA_EXTERNAL_ROUTE = "<route>", which
  ExternalDestination.fromLegacyRoute parses into a top-level destination.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="live_tv"
        android:enabled="true"
        android:icon="@drawable/ic_live_tv_24"
        android:shortcutShortLabel="@string/shortcut_live_short"
        android:shortcutLongLabel="@string/shortcut_live_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.megastream.app"
            android:targetClass="com.MegaStream.app.MainActivity">
            <extra android:name="com.MegaStream.app.extra.EXTERNAL_ROUTE" android:value="live_tv" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="movies"
        android:enabled="true"
        android:icon="@drawable/ic_movie_24"
        android:shortcutShortLabel="@string/shortcut_movies_short"
