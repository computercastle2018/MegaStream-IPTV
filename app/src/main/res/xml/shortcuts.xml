        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.megastream.app"
            android:targetClass="com.MegaStream.app.MainActivity">
            <extra android:name="com.MegaStream.app.extra.EXTERNAL_ROUTE" android:value="movies" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="series"
        android:enabled="true"
        android:icon="@drawable/ic_series_24"
