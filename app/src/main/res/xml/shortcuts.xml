        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.megastream.app"
            android:targetClass="com.MegaStream.app.MainActivity">
            <extra android:name="com.MegaStream.app.extra.EXTERNAL_ROUTE" android:value="series" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_search_24"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.megastream.app"
