# Copy to .env and fill locally. No real secrets belong in this file.
# Generate independent random passwords; hex avoids connection-string delimiters.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Independent persistent base64 secret (at least 32 decoded random bytes).
# Generate with: openssl rand -base64 32. Retain with database backups.
DEVICE_SECRET_PEPPER=

# Separate provider encryption key: exactly 32 random bytes encoded as base64.
# Generate independently with: openssl rand -base64 32. Never reuse the pepper.
PROVIDER_SECRET_KEY=
PROVIDER_SECRET_KEY_VERSION=1

# Bootstrap only: used when no administrator exists. Remove after initial seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Locked public Plesk hostname; a hostname is not a secret.
ALLOWED_HOSTS=megastrem.megastation.uk
APP_PORT=5080
# Required exact origin outside Testing; no path or trailing slash.
UPDATES_PUBLIC_ORIGIN=https://megastrem.megastation.uk

# Comma-separated IPs of explicitly trusted proxy peers AS SEEN BY THE APP.
# Determine the Docker bridge/Plesk peer; do not trust every network.
TRUSTED_PROXIES=

# Existing P-256 PEM outside image; container mounts it read-only.
SIGNING_KEY_HOST_PATH=./secrets/license-signing.pem

# Separate RSA certificate/private key PFX for DataProtection encryption at rest.
# Do not reuse the P-256 signing key. Store password externally, not in this sample.
DATA_PROTECTION_CERTIFICATE_HOST_PATH=./secrets/data-protection.pfx
DATA_PROTECTION_CERTIFICATE_PASSWORD=

# Retention accepts 1..90 days; presence window defaults to 10 minutes.
DIAGNOSTIC_RETENTION_DAYS=30
ONLINE_WINDOW_MINUTES=10
