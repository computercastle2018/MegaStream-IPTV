<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>@ViewData["Title"] — MegaStream</title><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /></head>
<body><a class="skip" href="#main">تخطي إلى المحتوى</a><header><a class="brand" asp-controller="Admin" asp-action="Index">MegaStream <span>لوحة الإدارة</span></a>
@if (User.Identity?.IsAuthenticated == true) { <nav aria-label="القائمة الرئيسية"><a asp-controller="Admin" asp-action="Index">الرئيسية</a><a asp-controller="Admin" asp-action="Licenses">التراخيص</a><a asp-controller="Admin" asp-action="Devices">الأجهزة</a><a asp-controller="Admin" asp-action="Codes">رموز التفعيل</a><a asp-controller="Admin" asp-action="Diagnostics">التشخيص</a><a href="/admin/updates">التحديثات</a><a href="/admin/providers">الاشتراكات</a></nav><form asp-controller="Account" asp-action="Logout" method="post"><button class="secondary" type="submit">تسجيل الخروج</button></form> }
</header><main id="main"><h1>@ViewData["Title"]</h1>@RenderBody()</main><footer>إدارة آمنة • جميع الأوقات بالتوقيت العالمي UTC • لا تُعرض أسرار الأجهزة</footer>@await RenderSectionAsync("Scripts", required: false)</body></html>
