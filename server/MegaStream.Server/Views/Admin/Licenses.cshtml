@model IReadOnlyList<License>
@{ ViewData["Title"] = "التراخيص"; }
<a class="button" asp-action="CreateLicense">إنشاء ترخيص</a><p class="muted">أحدث 500 ترخيص. لا يمكن استعادة المفتاح الكامل بعد إنشائه.</p><section class="panel table-wrap"><table><thead><tr><th>الاسم</th><th>آخر 4 أحرف</th><th>الحالة</th><th>الصلاحية حتى UTC</th><th>حد الأجهزة</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Label</td><td><code>•••• @item.KeyLast4</code></td><td>@AdminDisplay.LicenseState(item.Status)</td><td>@item.ValidUntil.ToString("yyyy-MM-dd HH:mm")</td><td>@item.MaxInstallations</td><td><a asp-action="LicenseDetails" asp-route-id="@item.Id">إدارة</a></td></tr> }</tbody></table>@if(Model.Count == 0) { <p class="empty">لا توجد تراخيص.</p> }</section>
