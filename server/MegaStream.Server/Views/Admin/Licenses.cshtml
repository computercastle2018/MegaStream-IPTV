@model IReadOnlyList<License>
@{ ViewData["Title"] = "التراخيص"; }
<div class="actions"><a class="button" asp-action="CreateLicense"><partial name="_Icon" model='"plus"' />إنشاء ترخيص</a></div><p class="muted">أحدث 500 ترخيص. لا يمكن استعادة المفتاح الكامل بعد إنشائه.</p><section class="panel table-wrap table-wrap--scroll"><table><thead><tr><th>الاسم</th><th>آخر 4 أحرف</th><th>الحالة</th><th>الصلاحية حتى UTC</th><th>حد الأجهزة</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Label</td><td><code>•••• @item.KeyLast4</code></td><td><span class="badge @(item.Status == LicenseStatus.Active ? "success" : item.Status == LicenseStatus.Suspended ? "warning" : "danger")">@AdminDisplay.LicenseState(item.Status)</span></td><td>@item.ValidUntil.ToString("yyyy-MM-dd HH:mm")</td><td>@item.MaxInstallations</td><td><a asp-action="LicenseDetails" asp-route-id="@item.Id">إدارة</a></td></tr> }</tbody></table>@if(Model.Count == 0) { <p class="empty"><partial name="_Icon" model='"inbox"' />لا توجد تراخيص.</p> }</section>
