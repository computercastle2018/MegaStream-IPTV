@model LicenseDetailsViewModel
@{ ViewData["Title"] = "إدارة الترخيص"; }
<section class="panel">
    <h2>تصميم واجهة العميل / مجموعة الأجهزة</h2>
    <form asp-action="SetLicenseUiStyle" method="post">
        <input type="hidden" name="Id" value="@Model.License.Id" />
        <label for="license-ui-style">تصميم الأجهزة المرتبطة بالترخيص</label>
        <select id="license-ui-style" name="UiStyle">
            <option value="">اختيار الجهاز المحلي</option>
            @foreach (var style in new[] { "classic", "modern", "studio" })
            { <option value="@style" selected="@(Model.License.UiStyle == style)">@AdminDisplay.UiStyleName(style)</option> }
        </select>
        <button type="submit">حفظ التصميم</button>
    </form>
</section>
<div asp-validation-summary="All" class="validation" role="alert"></div><section class="panel"><h2>@Model.License.Label</h2><dl><dt>آخر أحرف المفتاح</dt><dd><code>•••• @Model.License.KeyLast4</code></dd><dt>الحالة</dt><dd>@AdminDisplay.LicenseState(Model.License.Status)</dd><dt>بداية الصلاحية UTC</dt><dd>@Model.License.ValidFrom.ToString("yyyy-MM-dd HH:mm")</dd><dt>نهاية الصلاحية UTC</dt><dd>@Model.License.ValidUntil.ToString("yyyy-MM-dd HH:mm")</dd></dl><div class="actions">@foreach (var state in Enum.GetValues<LicenseStatus>()) { <form asp-action="SetLicenseStatus" method="post"><input type="hidden" name="Id" value="@Model.License.Id" /><input type="hidden" name="Status" value="@state" /><button type="submit" class="secondary">@(state == LicenseStatus.Active ? "إعادة تنشيط" : state == LicenseStatus.Suspended ? "تعليق" : "إلغاء الترخيص")</button></form> }</div></section>
<section class="panel"><h2>تمديد الصلاحية وتعديل السعة</h2><form asp-action="UpdateLicenseLimits" method="post"><input type="hidden" name="Id" value="@Model.License.Id" /><label for="ValidUntil">نهاية الصلاحية UTC</label><input id="ValidUntil" name="ValidUntil" type="datetime-local" value="@Model.Limits.ValidUntil.ToString("yyyy-MM-ddTHH:mm")" required /><label for="MaxInstallations">الحد الأقصى للأجهزة</label><input id="MaxInstallations" name="MaxInstallations" type="number" min="1" max="10000" value="@Model.Limits.MaxInstallations" required /><button type="submit">حفظ الصلاحية والسعة</button></form></section>
<section class="panel"><h2>مهلة العمل دون اتصال</h2><form asp-action="SetOfflineGrace" method="post"><input type="hidden" name="Id" value="@Model.License.Id" /><label for="OfflineGraceDays">الأيام (1–3)</label><input id="OfflineGraceDays" name="OfflineGraceDays" type="number" min="1" max="3" value="@Model.License.OfflineGraceDays" required /><p class="muted">المهلة من يوم واحد إلى ثلاثة أيام فقط؛ الافتراضي ثلاثة أيام.</p><button type="submit">حفظ المهلة</button></form></section>
<section class="panel"><h2>الأجهزة المرتبطة</h2><p class="notice">إلغاء الجهاز لا يحرر سعته فوراً: تبقى محجوزة حتى انتهاء آخر تصريح صادر له.</p><partial name="_DevicesTable" model="@(new DevicesViewModel(Model.Devices, DateTime.UtcNow.AddMinutes(-MegaStream.Server.Controllers.AdminController.OnlineWindowMinutes(Context.RequestServices.GetRequiredService<IConfiguration>()))))" /></section>
