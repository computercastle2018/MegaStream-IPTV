@model DevicesViewModel
<div class="table-wrap"><table><thead><tr><th>الجهاز</th><th>المنصة</th><th>الإصدار</th><th>الاتصال</th><th>حالة الترخيص</th><th>آخر ظهور UTC</th><th>حجز السعة حتى UTC</th><th></th></tr></thead><tbody>@foreach(var d in Model.Devices) { <tr><td>@d.DeviceModel</td><td>@d.Platform</td><td>@d.AppVersion</td><td><span class="badge @AdminDisplay.DeviceConnectionClass(d, Model.OnlineCutoff)">@AdminDisplay.DeviceState(d, Model.OnlineCutoff)</span></td><td>@AdminDisplay.DeviceLicenseState(d)</td><td>@d.LastSeenAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@(d.LastLeaseExpiresAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</td><td><a asp-action="DeviceDetails" asp-route-id="@d.Id">تفاصيل</a></td></tr> }</tbody></table>@if(Model.Devices.Count == 0) { <p class="empty">لا توجد أجهزة.</p> }</div>
