@model CodesViewModel
@{ ViewData["Title"] = "رموز التفعيل"; }
<section class="panel">
    <h2>توليد مفتاح تفعيل</h2>
    <partial name="_CreateLicenseForm" model="new CreateLicenseForm()" />
</section>
<h2>طلبات تفعيل الأجهزة</h2>
<div asp-validation-summary="All" class="validation" role="alert"></div><p class="muted">تُعرض آخر أربعة أحرف فقط. الموافقة ترتبط بالطلب والجهاز المحددين.</p><section class="panel table-wrap"><table><thead><tr><th>آخر أحرف الرمز</th><th>الجهاز</th><th>الحالة</th><th>الانتهاء UTC</th><th>الموافقة</th></tr></thead><tbody>@foreach(var c in Model.Codes) { <tr><td><code>•••• @c.CodeLast4</code></td><td><a asp-action="DeviceDetails" asp-route-id="@c.InstallationId">@c.Installation.DeviceModel</a><small>@c.InstallationId</small></td><td>@(c.ExpiresAt <= DateTime.UtcNow && c.Status == ActivationCodeStatus.Pending ? "منتهي" : AdminDisplay.CodeState(c.Status))</td><td>@c.ExpiresAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@if(c.Status == ActivationCodeStatus.Pending && c.ExpiresAt > DateTime.UtcNow) { <form asp-action="ApproveCode" method="post"><input type="hidden" name="Id" value="@c.Id" /><label for="license-@c.Id">اختر الترخيص</label><select id="license-@c.Id" name="LicenseId" required><option value="">اختر ترخيصاً</option>@foreach(var l in Model.Licenses) { <option value="@l.Id">@l.Label — •••• @l.KeyLast4</option> }</select><button type="submit">موافقة</button></form> }</td></tr> }</tbody></table>@if(Model.Codes.Count == 0) { <p class="empty">لا توجد طلبات تفعيل.</p> }</section>
