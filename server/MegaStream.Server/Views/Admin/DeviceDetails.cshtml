@model DeviceDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل الجهاز";
    var now = DateTime.UtcNow;
    var licenseHealthy = Model.Device.Status == InstallationStatus.Active && Model.Device.License is { Status: LicenseStatus.Active } license
        && license.ValidFrom <= now && license.ValidUntil > now;
    var licenseBadge = Model.Device.Status == InstallationStatus.Revoked ? "danger" : licenseHealthy ? "active" : "warning";
    var effectiveQuality = MegaStream.Server.Services.PlaybackQualityPolicy.Resolve(Model.Device.PlaybackQuality, Model.GlobalPlaybackQuality);
}
<div class="device-detail">
    <header id="device-summary" class="device-heading">
        <div class="device-heading-row">
            <h2>@(string.IsNullOrWhiteSpace(Model.Device.DeviceModel) ? "الجهاز" : Model.Device.DeviceModel)</h2>
            <span class="badge @AdminDisplay.DeviceConnectionClass(Model.Device, Model.OnlineCutoff)">@AdminDisplay.DeviceState(Model.Device, Model.OnlineCutoff)</span>
            <span class="badge @licenseBadge">@AdminDisplay.DeviceLicenseState(Model.Device)</span>
            <a asp-action="Devices">جميع الأجهزة</a>
        </div>
        <div class="device-summary-grid">
            <dl class="device-facts">
                <dt>المعرّف</dt><dd><bdi>@Model.Device.Id</bdi></dd>
                <dt>المنصة / النظام</dt><dd><bdi>@Model.Device.Platform / @Model.Device.OsVersion</bdi></dd>
                <dt>الشركة</dt><dd>@Model.Device.Manufacturer</dd>
                <dt>إصدار التطبيق</dt><dd><bdi>@Model.Device.AppVersion</bdi></dd>
                <dt>عنوان MAC</dt><dd><bdi>@(Model.Device.MacAddress ?? "غير متوفر")</bdi></dd>
                <dt>آخر ظهور UTC</dt><dd><bdi>@Model.Device.LastSeenAt.ToString("yyyy-MM-dd HH:mm:ss")</bdi></dd>
                <dt>آخر تصريح ينتهي UTC</dt><dd><bdi>@(Model.Device.LastLeaseExpiresAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "غير متوفر")</bdi></dd>
            </dl>
            <div class="device-report">
    <dl data-device-version-refresh data-device-version-url="@Url.Action("DeviceDetails", "Admin", new { id = Model.Device.Id })" aria-live="polite">
        <dt>الإصدار الفعلي المبلغ عنه</dt><dd><bdi data-device-version-value>@(Model.VersionReport is { } version ? $"{version.AppVersionName ?? Model.Device.AppVersion} ({version.AppVersionCode})" : "لم يصل بلاغ إصدار من عميل V1")</bdi></dd>
        <dt>آخر بلاغ إصدار UTC</dt><dd><bdi data-device-version-reported-at>@(Model.VersionReport?.VersionReportedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "غير متوفر")</bdi></dd>
    </dl>
                <dl class="device-facts">
                    <dt>الترخيص</dt><dd>@if (Model.Device.LicenseId.HasValue) { <a asp-action="LicenseDetails" asp-route-id="@Model.Device.LicenseId">@Model.Device.License?.Label</a> } else { <span>غير مرتبط</span> }</dd>
                    <dt>جودة التشغيل</dt><dd><bdi>@(effectiveQuality == "auto" ? "تلقائية" : effectiveQuality + "p")</bdi></dd>
                    <dt>تصميم الواجهة</dt><dd>@AdminDisplay.UiStyleName(Model.Device.UiStyle ?? Model.Device.License?.UiStyle)</dd>
                </dl>
            </div>
        </div>
    </header>
    <nav class="device-section-nav" aria-label="أقسام تفاصيل الجهاز">
        <a href="#device-quality">الجودة والتصميم</a>
        <a href="#device-updates">التحديثات</a>
        <a href="#device-license">الترخيص</a>
        <a href="#device-subscriptions">الاشتراكات</a>
        <a href="#device-subscription-policy">معلومات الاشتراك</a>
        <a href="#device-policy">سياسة الجهاز</a>
        <a href="#device-history">السجلات</a>
    </nav>
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <div class="device-control-grid">
<section id="device-quality" class="panel">
    <h2>جودة التشغيل</h2>
    <p class="muted">الجودة الفعّالة: <bdi>@(effectiveQuality == "auto" ? "تلقائية" : effectiveQuality + "p")</bdi></p>
    @if (Model.Device.Status == InstallationStatus.Active)
    {
        <form asp-action="SetDevicePlaybackQuality" method="post">
            <input type="hidden" name="Id" value="@Model.Device.Id" />
            <label for="device-playback-quality">جودة هذا الجهاز</label>
            <select id="device-playback-quality" name="PlaybackQuality">
                <option value="" selected="@(Model.Device.PlaybackQuality == null)">وراثة الافتراضي العام</option>
                @foreach (var quality in MegaStream.Server.Services.PlaybackQualityPolicy.Values)
                { <option value="@quality" selected="@(Model.Device.PlaybackQuality == quality)">@(quality == "auto" ? "تلقائية" : quality + "p")</option> }
            </select>
            <button type="submit">حفظ جودة الجهاز</button>
        </form>
    }
    <p><a asp-action="Devices">إدارة الجودة الافتراضية وجميع الأجهزة</a></p>
</section>
<section id="device-appearance" class="panel">
    <h2>تصميم واجهة الجهاز</h2>
    <p>التصميم الفعّال: <bdi>@AdminDisplay.UiStyleName(Model.Device.UiStyle ?? Model.Device.License?.UiStyle)</bdi></p>
    @if (Model.Device.Status == InstallationStatus.Active)
    {
        <form asp-action="SetDeviceUiStyle" method="post">
            <input type="hidden" name="Id" value="@Model.Device.Id" />
            <label for="device-ui-style">تجاوز تصميم الجهاز</label>
            <select id="device-ui-style" name="UiStyle">
                <option value="">وراثة الترخيص أو اختيار الجهاز المحلي</option>
                @foreach (var style in new[] { "classic", "modern", "studio" })
                { <option value="@style" selected="@(Model.Device.UiStyle == style)">@AdminDisplay.UiStyleName(style)</option> }
            </select>
            <button type="submit">حفظ التصميم</button>
        </form>
    }
</section>
</div>
<section id="device-updates" class="panel">
    <h2>إصدار التطبيق والتحديث عن بُعد</h2>

    <p><a asp-action="DeviceDetails" asp-route-id="@Model.Device.Id">فحص أحدث إصدار متوافق</a> · <a href="/admin/updates">إدارة إصدارات التطبيق</a></p>
    @if (Model.AvailableUpdates.Count > 0)
    {
        <form method="post" action="/admin/updates/send">
            @Html.AntiForgeryToken()
            <input type="hidden" name="InstallationIds" value="@Model.Device.Id" />
            <label for="device-update">الإصدار</label><select id="device-update" name="ReleaseId" required>
                @foreach (var release in Model.AvailableUpdates) { <option value="@release.Id">@release.VersionName (@release.VersionCode) — @release.Abi</option> }
            </select>
            <label for="device-update-mode">وضع التثبيت</label><select id="device-update-mode" name="Mode">
                <option value="prompt">طلب تأكيد المستخدم</option>
                @if (Model.ManagedDevice) { <option value="managed">تثبيت مُدار</option> }
            </select>
            <button type="submit">إرسال أمر تحديث لهذا الجهاز</button>
        </form>
    }
    else { <p class="empty">لا يوجد إصدار أحدث منشور ومتوافق بحسب آخر بلاغ.</p> }
    <p class="notice">إرسال الأمر لا يعني تثبيت الإصدار. يظل الإصدار الفعلي حسب بلاغ الجهاز؛ قد يتطلب التثبيت موافقة المستخدم.</p>
    <details id="device-update-commands" class="device-table-card">
        <summary>أوامر التحديث <span class="badge">@Model.UpdateCommands.Count</span></summary>
    <div class="table-wrap"><table><thead><tr><th>الإصدار المطلوب</th><th>حالة الأمر</th><th>آخر تحديث UTC</th></tr></thead><tbody>
        @foreach (var command in Model.UpdateCommands)
        { <tr><td><bdi>@command.Release.VersionName (@command.Release.VersionCode)</bdi></td><td><bdi>@command.Status</bdi></td><td>@command.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td></tr> }
    </tbody></table></div>
    </details>
</section>
@section Scripts {
    <script src="~/js/device-version-refresh.js" asp-append-version="true" defer></script>
    <script src="~/js/provider-credentials.js" asp-append-version="true" defer></script>
}
<section id="device-subscription-policy" class="panel">
    <h2>سياسة معلومات الاشتراك</h2>
    <dl><dt>عنوان MAC المبلغ عنه</dt><dd><bdi>@(Model.Device.MacAddress ?? "غير متوفر")</bdi></dd></dl>
    @if (Model.Device.Status == InstallationStatus.Active)
    {
        <form asp-action="SetSubscriptionDetailsPolicy" method="post">
            <input type="hidden" name="Id" value="@Model.Device.Id" />
            <label><input type="checkbox" name="AllowSubscriptionDetails" value="true" checked="@Model.Device.AllowSubscriptionDetails" /> السماح بعرض معلومات الاشتراك وإدخالها</label>
            <input type="hidden" name="AllowSubscriptionDetails" value="false" />
            <button type="submit">حفظ سياسة الاشتراك</button>
        </form>
        <p><a asp-action="Notifications" asp-route-targetInstallationId="@Model.Device.Id">إرسال إشعار لهذا الجهاز</a></p>
    }
</section>
<section id="device-license" class="panel">
    <h2>ترخيص الجهاز</h2>
    <dl><dt>حالة الترخيص</dt><dd>@AdminDisplay.DeviceLicenseState(Model.Device)</dd></dl>
    @if (Model.Device.License is { } assignedLicense)
    {
        <p><a asp-action="LicenseDetails" asp-route-id="@assignedLicense.Id">@assignedLicense.Label</a></p>
    }
    @if (Model.Device.Status == InstallationStatus.Active && !Model.Device.LicenseId.HasValue)
    {
        <form asp-action="AssignDeviceLicense" method="post">
            <input type="hidden" name="Id" value="@Model.Device.Id" />
            <label for="device-license-choice">الترخيص</label>
            <select id="device-license-choice" name="LicenseId" required>
                <option value="">اختر الترخيص</option>
                @foreach (var license in Model.AvailableLicenses)
                {
                    <option value="@license.Id">@license.Label — حتى @license.ValidUntil.ToString("yyyy-MM-dd")</option>
                }
            </select>
            <button type="submit" disabled="@(Model.AvailableLicenses.Count == 0)">ترخيص الجهاز</button>
        </form>
        @if (Model.AvailableLicenses.Count == 0)
        {
            <p><a asp-action="CreateLicense">إنشاء ترخيص</a></p>
        }
    }
</section>
<section id="device-subscriptions" class="panel">
    <div class="device-section-heading">
        <h2>الاشتراكات الموجودة على الجهاز</h2>
        <a class="button secondary" href="/admin/providers/installations/@Model.Device.Id">إدارة اشتراكات الجهاز</a>
    </div>
    <p>اتصال الجهاز: <span class="badge @AdminDisplay.DeviceConnectionClass(Model.Device, Model.OnlineCutoff)">@AdminDisplay.DeviceState(Model.Device, Model.OnlineCutoff)</span></p>
    @if (Model.Device.LocalSubscriptionsReportedAt is { } reportedAt)
    {
        <p class="muted">آخر بلاغ UTC: @reportedAt.ToString("yyyy-MM-dd HH:mm:ss")</p>
        <details id="device-subscriptions-table" class="device-table-card" open>
            <summary>اشتراكات الجهاز <span class="badge">@Model.LocalSubscriptions.Count</span></summary>
        <div class="table-wrap"><table><thead><tr><th>الاشتراك</th><th>النوع</th><th>الحالة</th><th>المعلومات</th></tr></thead><tbody>
        @foreach (var subscription in Model.LocalSubscriptions)
        {
            <tr><td>@subscription.Name</td><td><bdi>@(subscription.Type switch { "xtream_codes" => "Xtream", "m3u" => "M3U", _ => "Stalker" })</bdi></td><td>@subscription.DisplayState</td><td>
                <details class="subscription-information"><summary>إظهار / إخفاء معلومات الاشتراك</summary>
                    <dl><dt>بداية الاشتراك UTC</dt><dd>@(subscription.StartedAt.HasValue ? DateTimeOffset.FromUnixTimeMilliseconds(subscription.StartedAt.Value).ToString("yyyy-MM-dd HH:mm:ss") : "غير معروفة")</dd>
                    <dt>الصلاحية UTC</dt><dd>@(subscription.ExpiresAt.HasValue ? DateTimeOffset.FromUnixTimeMilliseconds(subscription.ExpiresAt.Value).ToString("yyyy-MM-dd HH:mm:ss") : "غير محددة")</dd>
                    <dt>حد الاتصالات</dt><dd>@subscription.MaxConnections</dd><dt>مفعّل على الجهاز</dt><dd>@(subscription.Enabled ? "نعم" : "لا")</dd></dl>
                    @if (Model.Device.Status == InstallationStatus.Active && Model.LocalCredentialIds.Contains(subscription.LocalId))
                    {
                        var access = new MegaStream.Server.RemoteProviders.Http.ProviderAccess($"/admin/providers/installations/{Model.Device.Id}/subscriptions/{subscription.LocalId}", subscription.Type != "stalker_portal");
                        <partial name="~/RemoteProviders/Views/_ProviderAccess.cshtml" model="access" />
                    }
                    else { <p class="muted">بيانات الدخول غير متاحة في آخر بلاغ من الجهاز.</p> }
                </details>
            </td></tr>
        }
        </tbody></table></div>
        </details>
        @if (Model.LocalSubscriptions.Count == 0) { <p class="empty">لا توجد اشتراكات محفوظة بحسب آخر بلاغ.</p> }
    }
    else
    {
        <p class="empty">لم تصل بيانات الاشتراكات من الجهاز بعد.</p>
    }
</section>
<section id="device-policy" class="panel">
    <h2>سياسة الكشك</h2>
    <p class="notice">@(Model.ManagedDevice ? "جهاز مُدار بحسب آخر بلاغ — التطبيق الفعلي يعتمد على قدرات الجهاز" : "غير مدعوم — لا يفرض على الجهاز")</p>
    <dl><dt>الوضع المطلوب</dt><dd>@AdminDisplay.KioskState(Model.Device.KioskMode)</dd><dt>الخروج المحلي</dt><dd>@(Model.Device.AllowLocalExit ? "مسموح" : "غير مسموح بحسب السياسة المطلوبة")</dd></dl>
    <partial name="_DevicePolicyForm" model="@(new DevicePolicyForm { Id = Model.Device.Id, KioskMode = Enum.TryParse<AdminKioskMode>(Model.Device.KioskMode, out var kioskMode) ? kioskMode : null, AllowLocalExit = Model.Device.AllowLocalExit })" />
    @if (Model.Device.Status == InstallationStatus.Active)
    {
        <details class="device-log device-danger">
            <summary>إجراءات الجهاز</summary>
            <form asp-action="RevokeDevice" method="post">
                <input type="hidden" name="Id" value="@Model.Device.Id" />
                <p class="notice">الإلغاء يمنع إصدار تصاريح جديدة، مع بقاء السعة محجوزة حتى انتهاء التصريح الحالي.</p>
                <button class="danger" type="submit">إلغاء الجهاز</button>
            </form>
        </details>
    }
</section>

<section id="device-history" class="panel">
    <h2>السجلات</h2>
<details id="device-audit" class="device-table-card">
    <summary>سجل تغييرات السياسة <span class="badge">@Model.PolicyAudit.Count</span></summary>
    <p class="muted">أحدث 100 تغيير. للقراءة فقط.</p>
    <div class="table-wrap"><table><thead><tr><th>الوقت UTC</th><th>المسؤول</th><th>الوضع السابق</th><th>الوضع الجديد</th><th>الخروج المحلي سابقاً</th><th>الخروج المحلي الآن</th></tr></thead><tbody>
    @foreach (var audit in Model.PolicyAudit)
    {
        <tr><td>@audit.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@audit.ActorId</td><td>@AdminDisplay.KioskState(audit.OldKioskMode)</td><td>@AdminDisplay.KioskState(audit.NewKioskMode)</td><td>@(audit.OldAllowLocalExit ? "مسموح" : "غير مسموح")</td><td>@(audit.NewAllowLocalExit ? "مسموح" : "غير مسموح")</td></tr>
    }
    </tbody></table></div>
    @if (Model.PolicyAudit.Count == 0) { <p class="empty">لا توجد تغييرات مسجلة.</p> }
</details>
    <details id="device-sessions" class="device-table-card">
        <summary>الجلسات الأخيرة <span class="badge">@Model.Sessions.Count</span></summary>
<div class="table-wrap"><table><thead><tr><th>بدأت UTC</th><th>آخر نبضة UTC</th><th>انتهت UTC</th><th>الذاكرة بالبايت</th><th>سبب الخروج</th><th>الإصدار</th></tr></thead><tbody>@foreach(var s in Model.Sessions) { <tr><td>@s.StartedAt.ToString("u")</td><td>@s.LastHeartbeatAt.ToString("u")</td><td>@s.EndedAt?.ToString("u")</td><td>@s.MemoryBytes</td><td>@s.ExitReason</td><td>@s.AppVersion</td></tr> }</tbody></table></div>
    </details>
    <details id="device-diagnostics" class="device-table-card">
        <summary>أحدث أحداث التشخيص <span class="badge">@Model.Diagnostics.Count</span></summary>
        <partial name="_DiagnosticsTable" model="Model.Diagnostics" />
    </details>
</section>
</div>
