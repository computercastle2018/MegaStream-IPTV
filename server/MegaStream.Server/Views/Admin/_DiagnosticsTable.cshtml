@model IReadOnlyList<DiagnosticEvent>
@if (Model.Count == 0) { <p class="empty">لا توجد أحداث مطابقة.</p> } else { <div class="table-wrap"><table><thead><tr><th>الوقت UTC</th><th>المستوى</th><th>الفئة</th><th>الرسالة المنقحة</th><th>التفاصيل</th></tr></thead><tbody>@foreach(var item in Model) { <tr><td>@item.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@item.Level</td><td>@item.Category</td><td class="message">@item.Message</td><td><a asp-controller="Admin" asp-action="DiagnosticDetails" asp-route-id="@item.Id">عرض</a></td></tr> }</tbody></table></div> }
