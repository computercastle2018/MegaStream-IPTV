@model DiagnosticsViewModel
@{ ViewData["Title"] = "التشخيص"; }
<section class="panel"><h2>تصفية الأحداث</h2><form asp-action="Diagnostics" method="get"><div asp-validation-summary="All" class="validation" role="alert"></div><div class="filters"><div><label asp-for="Level">المستوى</label><input asp-for="Level" maxlength="16" /></div><div><label asp-for="Category">الفئة</label><input asp-for="Category" maxlength="64" /></div><div><label asp-for="InstallationId">معرّف الجهاز</label><input asp-for="InstallationId" /></div><div class="actions"><button type="submit">تصفية</button><a class="button secondary" asp-action="Diagnostics">مسح التصفية</a></div></div></form></section><section class="panel"><p class="muted">آخر 300 حدث مطابق، بعد تنقيح البيانات الحساسة.</p><partial name="_DiagnosticsTable" model="Model.Events" /></section>
