@model DiagnosticDetailsViewModel
@{ ViewData["Title"] = "تفاصيل التشخيص"; }
<section class="panel"><dl><dt>الجهاز</dt><dd><a asp-action="DeviceDetails" asp-route-id="@Model.Event.InstallationId">@Model.Event.InstallationId</a></dd><dt>الوقت UTC</dt><dd>@Model.Event.OccurredAt.ToString("u")</dd><dt>المستوى / الفئة</dt><dd>@Model.Event.Level / @Model.Event.Category</dd><dt>الجلسة</dt><dd>@Model.Event.SessionId</dd><dt>إصدار التطبيق / الجهاز</dt><dd>@Model.Event.AppVersion / @Model.Event.DeviceVersion</dd><dt>الذاكرة بالبايت</dt><dd>@Model.Event.MemoryBytes</dd><dt>القناة / المصدر</dt><dd>@Model.Event.ChannelName / @Model.Event.SourceType</dd><dt>الحاوية / الفيديو / الصوت</dt><dd>@Model.Event.Container / @Model.Event.VideoCodec / @Model.Event.AudioCodec</dd></dl><h2>الرسالة المنقحة</h2><pre>@Model.Event.Message</pre><h2>تتبع الخطأ المنقح</h2><pre dir="ltr">@Model.Event.StackTrace</pre>@if(!string.IsNullOrEmpty(Model.PayloadJson)) { <h2>البيانات التشخيصية المهيكلة</h2><pre dir="ltr">@Model.PayloadJson</pre> }</section>
