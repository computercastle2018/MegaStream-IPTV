@model MegaStream.Server.RemoteProviders.Http.ProviderIndex
@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "الاشتراكات"; }
<div class="actions"><a class="button" href="/admin/providers/create?type=XTREAM_CODES"><partial name="~/Views/Shared/_Icon.cshtml" model='"plus"' />إضافة Xtream Codes</a> <a class="button secondary" href="/admin/providers/create?type=M3U"><partial name="~/Views/Shared/_Icon.cshtml" model='"plus"' />إضافة M3U</a> <a class="button secondary" href="/admin/providers/create?type=STALKER_PORTAL"><partial name="~/Views/Shared/_Icon.cshtml" model='"plus"' />إضافة Stalker</a> <a class="button secondary" href="/admin/test-media"><partial name="~/Views/Shared/_Icon.cshtml" model='"play"' />فيديو اختبار من السيرفر</a></div>
<section class="panel">
<h2>الاشتراكات المحفوظة</h2>
<div class="table-wrap table-wrap--scroll">
<table>
<thead><tr><th>الاسم</th><th>النوع</th><th>الحالة</th><th>المراجعة</th><th>الإعدادات</th><th>الإجراء</th></tr></thead>
<tbody>
@foreach (var profile in Model.Profiles)
{
    <tr><td>@profile.DisplayName</td><td><bdi>@profile.Type</bdi></td><td><span class="badge @(profile.Status == "active" ? "success" : "danger")">@(profile.Status == "active" ? "نشط" : "ملغى")</span>
        @if (profile.SourceStatus is { } sourceStatus) { <br /><small>حالة المصدر: <span class="badge @(profile.SourceEnabled == false ? "offline" : sourceStatus switch { "active" => "success", "expired" => "warning", "partial" => "warning", "error" => "danger", "disabled" => "offline", _ => "" })">@(profile.SourceEnabled == false ? "غير مفعّل" : sourceStatus switch { "active" => "مفعّل", "expired" => "منتهي", "partial" => "مفعّل جزئياً", "error" => "خطأ", "disabled" => "متوقف", _ => "غير معروف" })</span></small> }
    </td><td>@profile.Revision</td><td>@(profile.DeletedAt.HasValue ? "محذوفة" : "محفوظة — مخفية")</td><td><a href="/admin/providers/@profile.Id">التفاصيل / استبدال الإعدادات</a>
        @if (profile.Status == "active" && !profile.DeletedAt.HasValue)
        {
            var access = new MegaStream.Server.RemoteProviders.Http.ProviderAccess($"/admin/providers/{profile.Id}", profile.Type != "STALKER_PORTAL");
            <partial name="~/RemoteProviders/Views/_ProviderAccess.cshtml" model="access" />
        }
    </td></tr>
}
</tbody>
</table>
@if (Model.Profiles.Count == 0) { <p class="empty"><partial name="~/Views/Shared/_Icon.cshtml" model='"inbox"' />لا توجد اشتراكات محفوظة.</p> }
</div>
</section>
<section class="panel">
<h2>اشتراكات الجهاز</h2>
@if (Model.Devices.Count > 0)
{
    <form method="get" action="/admin/providers/installations">
        <label for="provider-device">الجهاز</label>
        <select id="provider-device" name="installationId" required>
            <option value="">اختر الجهاز</option>
            @foreach (var device in Model.Devices)
            {
                <option value="@device.Id">@device.DeviceModel — @device.Id</option>
            }
        </select>
        <button type="submit">إدارة اشتراكات الجهاز</button>
    </form>
}
else { <p class="empty"><partial name="~/Views/Shared/_Icon.cshtml" model='"inbox"' />لا توجد أجهزة مسجلة متاحة.</p> }
</section>
<section class="panel">
<h2>آخر اشتراكات الأجهزة المتصلة والمرخّصة</h2>
<p class="muted">أحدث 500 جهاز نشط كحد أقصى. اتصال الجهاز وآخر بلاغ للاشتراكات خلال @Model.OnlineWindowMinutes دقيقة. حالة الاشتراك وصلاحيته حسب بلاغ الجهاز، وليستا بديلاً عن ترخيص MegaStream.</p>
@if (Model.HasInvalidReports) { <p class="validation" role="alert">تعذر عرض بعض بلاغات الاشتراكات لعدم صلاحية بياناتها.</p> }
<div class="table-wrap table-wrap--scroll">
<table><thead><tr><th>الاشتراك</th><th>نوع الخدمة</th><th>الحالة المبلّغة</th><th>الجهاز</th><th>ترخيص MegaStream</th><th>آخر بلاغ UTC</th><th>الصلاحية UTC</th><th>المعلومات</th></tr></thead><tbody>
@foreach (var subscription in Model.Subscriptions)
{
    <tr>
        <td>@subscription.Name</td>
        <td><bdi>@(subscription.Type switch { "xtream_codes" => "Xtream", "m3u" => "M3U", _ => "Stalker" })</bdi></td>
        <td>@subscription.State</td>
        <td><a href="/Admin/DeviceDetails?id=@subscription.InstallationId">@subscription.DeviceModel</a></td>
        <td>@if (subscription.LicenseId is { } licenseId) { <a href="/Admin/LicenseDetails?id=@licenseId">@subscription.LicenseLabel</a> } else { <span>غير مرخص</span> }</td>
        <td><bdi>@subscription.ReportedAt.ToString("yyyy-MM-dd HH:mm:ss")</bdi></td>
        <td><bdi>@(subscription.ExpiresAt.HasValue ? DateTimeOffset.FromUnixTimeMilliseconds(subscription.ExpiresAt.Value).ToString("yyyy-MM-dd HH:mm:ss") : "غير محددة")</bdi></td>
        <td><details class="subscription-information"><summary>إظهار / إخفاء معلومات الاشتراك</summary>
            <dl><dt>بداية الاشتراك UTC</dt><dd>@(subscription.StartedAt.HasValue ? DateTimeOffset.FromUnixTimeMilliseconds(subscription.StartedAt.Value).ToString("yyyy-MM-dd HH:mm:ss") : "غير معروفة")</dd>
                <dt>حد الاتصالات</dt><dd>@subscription.MaxConnections</dd></dl>
            <a href="/admin/providers/installations/@subscription.InstallationId">إدارة اشتراكات الجهاز</a>
            @if (subscription.HasCredentials)
            {
                var access = new MegaStream.Server.RemoteProviders.Http.ProviderAccess($"/admin/providers/installations/{subscription.InstallationId}/subscriptions/{subscription.LocalId}", subscription.Type != "stalker_portal");
                <partial name="~/RemoteProviders/Views/_ProviderAccess.cshtml" model="access" />
            }
            else { <p class="muted">بيانات الدخول غير متاحة في آخر بلاغ من الجهاز.</p> }
        </details></td>
    </tr>
}
</tbody></table>
@if (Model.Subscriptions.Count == 0) { <p class="empty"><partial name="~/Views/Shared/_Icon.cshtml" model='"inbox"' />لا توجد اشتراكات حديثة مبلغ عنها على أجهزة متصلة ومرخّصة.</p> }
</div>
</section>
@section Scripts { <script src="~/js/provider-credentials.js" asp-append-version="true" defer></script> }
